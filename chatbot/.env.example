# OpenRouter (chat + embeddings)
OPENROUTER_API_KEY=sk-or-v1-REPLACE_ME
OPENROUTER_CHAT_MODEL=meta-llama/llama-3.2-3b-instruct:free
OPENROUTER_EMBED_MODEL=openai/text-embedding-3-small
OPENROUTER_SITE_URL=http://localhost:3000
OPENROUTER_APP_NAME=ServeMe Marketplace

# Redis (LLM conversation context — must match backend)
REDIS_URL=redis://localhost:6379
CHATBOT_SESSION_TTL_DAYS=90

SUPABASE_URL=https://xxx.supabase.co
SUPABASE_SERVICE_ROLE_KEY=...
NESTJS_API_URL=http://localhost:3000
NESTJS_CHATBOT_SECRET=serveme-chatbot-secret-2026

# Search quality (optional)
CHATBOT_MAX_RESULTS=5
CHATBOT_MIN_SIMILARITY=0.40
