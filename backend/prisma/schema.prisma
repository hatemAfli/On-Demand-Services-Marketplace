// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

// Looking for ways to speed up your queries, or scale easily with your serverless or edge functions?
// Try Prisma Accelerate: https://pris.ly/cli/accelerate-init

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("DIRECT_URL")
  directUrl = env("DIRECT_URL")
}

// Enums
enum UserRole {
  CLIENT
  PROVIDER
  COMPANY_ADMIN
  PLATFORM_ADMIN
}

enum AccountStatus {
  PENDING
  ACTIVE
  REJECTED
  SUSPENDED
  DELETED
}

enum ProviderType {
  INDEPENDENT
  EMPLOYEE
}

/// Shown to clients for same-gender matching (e.g. home services).
enum ProviderGender {
  FEMALE
  MALE
}

/// Who submitted the verification (provider user vs company representative, etc.).
enum OwnerType {
  PROVIDER
  COMPANY
}

enum DocumentType {
  IDENTITY
  LICENSE
  QUALIFICATION
  INSURANCE
  OTHER
}

enum ReviewStatus {
  PENDING
  UNDER_REVIEW
  APPROVED
  REJECTED
}

enum PricingType {
  FIXED
  HOURLY
}

enum FavoriteType {
  CATEGORY
  SERVICE
  PROVIDER
}

enum Locale {
  EN
  AR
}

enum LegalDocumentType {
  TERMS
  PRIVACY
}

enum LegalDocumentStatus {
  DRAFT
  PUBLISHED
  ARCHIVED
}

enum DayOfWeek {
  MONDAY
  TUESDAY
  WEDNESDAY
  THURSDAY
  FRIDAY
  SATURDAY
  SUNDAY
}

enum AppointmentStatus {
  PENDING            // client sent request, waiting for provider response
  CONFIRMED          // provider accepted
  REFUSED            // provider refused with a reason
  RESCHEDULED        // provider proposed a new time — waiting for client response
  CANCELLED_CLIENT   // client cancelled after confirmation
  CANCELLED_PROVIDER // provider cancelled after confirmation
  EN_ROUTE           // provider marked "on the way"
  IN_PROGRESS        // both confirmed service start
  COMPLETED          // both confirmed service end
  DISPUTED           // flagged by either party for admin review
}

enum AppointmentConfirmationType {
  START
  END
}

enum NotificationType {
  // Appointment lifecycle
  APPOINTMENT_NEW_REQUEST // provider receives new booking request
  APPOINTMENT_CONFIRMED // client: provider accepted
  APPOINTMENT_REFUSED // client: provider refused
  APPOINTMENT_RESCHEDULED // client: provider proposed new time
  APPOINTMENT_RESCHEDULE_ACCEPTED // provider: client accepted reschedule
  APPOINTMENT_RESCHEDULE_DECLINED // provider: client declined reschedule
  APPOINTMENT_CANCELLED_CLIENT // provider: client cancelled
  APPOINTMENT_CANCELLED_PROVIDER // client: provider cancelled
  APPOINTMENT_REMINDER_24H // both: reminder 24h before
  APPOINTMENT_REMINDER_1H // both: reminder 1h before
  APPOINTMENT_EN_ROUTE // client: provider is on the way
  APPOINTMENT_STARTED // both: service started (awaiting other confirmation)
  APPOINTMENT_PROVIDER_ENDED // client: provider marked service ended; confirm to complete
  APPOINTMENT_COMPLETED // both: service completed
  // Account
  ACCOUNT_VERIFIED // provider/company: account approved
  ACCOUNT_REJECTED // provider/company: account rejected
  // Document verification
  DOCUMENT_ACCEPTED // provider: a document was accepted
  DOCUMENT_REJECTED // provider: a document was rejected
  // Review
  NEW_REVIEW // provider: client left a review
  // System
  SYSTEM_ANNOUNCEMENT // all users: platform announcement
}

enum MessageStatus {
  SENT // inserted in DB
  DELIVERED // recipient's device received it
  READ // recipient opened the conversation
}

// User Model (synced with Supabase Auth)
model User {
  id              String        @id @db.Uuid
  email           String        @unique
  phoneNumber     String?       @unique @map("phone_number")
  firstName       String        @map("first_name")
  lastName        String        @map("last_name")
  role            UserRole      @default(CLIENT)
  status          AccountStatus @default(PENDING)
  isEmailVerified Boolean       @default(false) @map("is_email_verified")
  isPhoneVerified Boolean       @default(false) @map("is_phone_verified")
  createdAt       DateTime      @default(now()) @map("created_at")
  updatedAt       DateTime      @updatedAt @map("updated_at")
  deletedAt       DateTime?      @map("deleted_at")

  /// Relations
  client                     Client?
  provider                   Provider?
  companyAdmin               CompanyAdmin?
  platformAdmin              PlatformAdmin?
  documents                  Document[]
  verificationProfilRequests VerificationProfilRequest[]
  legalAcceptances           UserLegalAcceptance[]
  pushTokens                 PushToken[]
  notifications              Notification[]
  sentMessages               Message[]

  @@map("users")
}

// Client Model 
model Client {
  id String @id @db.Uuid

  city     String
  address  String?
  imageUrl String? @map("image_url")

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  /// Relations
  user          User                  @relation(fields: [id], references: [id], onDelete: Cascade)
  searchHistory ClientSearchHistory[]
  favorites     ClientFavorite[]
  appointments  Appointment[]
  conversations Conversation[]

  @@map("clients")
}

// Provider-specific details
model Provider {
  id String @id @db.Uuid

  type                ProviderType @default(INDEPENDENT)
  city                String
  address             String?
  latitude            Float?
  longitude           Float?
  photoUrl            String?      @map("photo_url")
  /// One-liner for listings, e.g. "Certified electrician, 8 years in Tunis"
  tagline             String?      @map("tagline")
  /// Short personal introduction (a few sentences)
  bio                 String?      @db.Text @map("bio")
  yearsOfExperience   Int?         @map("years_of_experience")
  languagesSpoken     String[]     @default(["Arabic"]) @map("languages_spoken")
  gender              ProviderGender? @map("gender")
  totalReviews        Int          @default(0) @map("total_reviews")
  cancellationRate    Decimal?     @default(0) @db.Decimal(5, 2)
  averageResponseTime Decimal?     @map("average_response_time") @db.Decimal(10, 2)
  isTopProvider       Boolean      @default(false) @map("is_top_provider")
  paymentMethodsAccepted String[]  @default(["Cash"]) @map("payment_methods_accepted")
  companyId           String?      @map("company_id") @db.Uuid
  createdAt           DateTime     @default(now()) @map("created_at")
  updatedAt           DateTime     @updatedAt @map("updated_at")

  // Relations
  user          User           @relation(fields: [id], references: [id], onDelete: Cascade)
  company       Company?       @relation("CompanyProviders", fields: [companyId], references: [id])
  favoritedBy   ClientFavorite[] @relation("ClientFavoriteProvider")
  availability  ProviderAvailability[]
  daysOff       ProviderDayOff[]
  appointments  Appointment[]
  conversations Conversation[]

  @@map("providers")
}

/// One conversation thread between a client and a provider.
/// Created automatically the first time either party sends a message.
model Conversation {
  id         String @id @default(uuid()) @db.Uuid
  clientId   String @map("client_id") @db.Uuid
  providerId String @map("provider_id") @db.Uuid

  /// Snapshot of last message for list preview — updated on every new message.
  lastMessageText   String?   @map("last_message_text") @db.Text
  lastMessageAt     DateTime? @map("last_message_at")
  lastMessageSender String?   @map("last_message_sender") // "CLIENT" | "PROVIDER"

  /// Unread counters per side — reset to 0 when that side opens the conversation.
  unreadClient   Int @default(0) @map("unread_client")
  unreadProvider Int @default(0) @map("unread_provider")

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  client   Client    @relation(fields: [clientId], references: [id], onDelete: Cascade)
  provider Provider  @relation(fields: [providerId], references: [id], onDelete: Cascade)
  messages Message[]

  @@unique([clientId, providerId])
  @@index([clientId, lastMessageAt])
  @@index([providerId, lastMessageAt])
  @@map("conversations")
}

/// A single chat message inside a conversation.
model Message {
  id             String        @id @default(uuid()) @db.Uuid
  conversationId String        @map("conversation_id") @db.Uuid
  senderUserId   String        @map("sender_user_id") @db.Uuid // the User.id of the sender
  senderRole     String        @map("sender_role") // "CLIENT" | "PROVIDER"
  text           String?       @db.Text // null if media-only
  mediaUrls      String[]      @default([]) @map("media_urls") // photo attachments
  status         MessageStatus @default(SENT)
  readAt         DateTime?     @map("read_at")
  createdAt      DateTime      @default(now()) @map("created_at")

  conversation Conversation @relation(fields: [conversationId], references: [id], onDelete: Cascade)
  sender       User         @relation(fields: [senderUserId], references: [id], onDelete: Cascade)

  @@index([conversationId, createdAt])
  @@index([senderUserId])
  @@map("messages")
}

// company Admin model
model CompanyAdmin {
  id        String   @id @db.Uuid
  companyId String   @unique @map("company_id") @db.Uuid
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  // Relations
  user    User     @relation(fields: [id], references: [id], onDelete: Cascade)
  company Company? @relation

  @@map("company_admins")
}

// Company-specific details
// add legalDocuments, employees, calendar
model Company {
  id      String  @id @default(uuid()) @db.Uuid
  /// Set after `CompanyAdmin` row is created (bootstrap avoids a circular FK insert).
  /// DB column is `adminId` (legacy from initial migration).
  adminId String? @unique @db.Uuid

  companyName    String   @map("company_name")
  taxId          String   @map("tax_id")
  logo           String?  @map("logo")
  city           String
  address        String?
  latitude       Float?
  longitude      Float?
  serviceZones   String[] @default([]) @map("service_zones")
  email    String?   @map("email")
  averageRating  Decimal? @default(0) @db.Decimal(3, 2)
  totalReviews   Int      @default(0) @map("total_reviews")
  createdAt      DateTime @default(now()) @map("created_at")
  updatedAt      DateTime @updatedAt @map("updated_at")

  // Relations
  providers     Provider[]     @relation("CompanyProviders")
  admin         CompanyAdmin?  @relation(fields: [adminId], references: [id])

  @@map("companies")
}



// Platform Admins model
model PlatformAdmin {
  id          String   @id @db.Uuid
  createdAt   DateTime @default(now()) @map("created_at")
  updatedAt   DateTime @updatedAt @map("updated_at")
  permissions String[] @map("permissions")

  // Relations
  user                         User                   @relation(fields: [id], references: [id], onDelete: Cascade)
  createdLegalDocumentVersions LegalDocumentVersion[]

  @@map("platform_admins")
}

/// One row per legal document type (TERMS/PRIVACY). Localized fields live in `LegalDocumentTranslation`.
model LegalDocument {
  id String @id @default(uuid()) @db.Uuid
  /// Stable type key: only one legal "Terms" and one legal "Privacy".
  type           LegalDocumentType @unique
  currentVersion Int               @default(0) @map("current_version")
  createdAt      DateTime          @default(now()) @map("created_at")
  updatedAt      DateTime          @updatedAt @map("updated_at")

  versions LegalDocumentVersion[]

  @@map("legal_documents")
}

/// Version history and publish state for legal documents(terms & privacy).
model LegalDocumentVersion {
  id String @id @default(uuid()) @db.Uuid
  documentId String @map("document_id") @db.Uuid
  version Int
  status LegalDocumentStatus @default(DRAFT)
  publishedAt      DateTime?           @map("published_at")
  createdByAdminId String?             @map("created_by_admin_id") @db.Uuid
  createdAt        DateTime            @default(now()) @map("created_at")
  updatedAt        DateTime            @updatedAt @map("updated_at")

  document        LegalDocument         @relation(fields: [documentId], references: [id], onDelete: Cascade)
  createdByAdmin  PlatformAdmin?        @relation(fields: [createdByAdminId], references: [id], onDelete: SetNull)
  translations    LegalDocumentTranslation[]
  acceptances     UserLegalAcceptance[]

  @@unique([documentId, version])
  @@index([documentId, status, version])
  @@index([status, publishedAt])
  @@map("legal_document_versions")
}

/// One row per legal document version + locale (EN/AR).
model LegalDocumentTranslation {
  id String @id @default(uuid()) @db.Uuid
  documentVersionId String @map("document_version_id") @db.Uuid
  locale Locale
  title String
  contentMarkdown String @map("content_markdown") @db.Text
  summary String? @db.Text
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  documentVersion LegalDocumentVersion @relation(fields: [documentVersionId], references: [id], onDelete: Cascade)

  @@unique([documentVersionId, locale])
  @@index([documentVersionId])
  @@index([locale])
  @@map("legal_document_translations")
}

/// Audit trail for which legal version each user accepted.
model UserLegalAcceptance {
  id                String               @id @default(uuid()) @db.Uuid
  userId            String               @map("user_id") @db.Uuid
  documentVersionId String               @map("document_version_id") @db.Uuid
  acceptedAt        DateTime             @default(now()) @map("accepted_at")
  ipAddress         String?              @map("ip_address")
  userAgent         String?              @map("user_agent") @db.Text

  user            User                 @relation(fields: [userId], references: [id], onDelete: Cascade)
  documentVersion LegalDocumentVersion @relation(fields: [documentVersionId], references: [id], onDelete: Restrict)

  @@unique([userId, documentVersionId])
  @@index([userId, acceptedAt])
  @@index([documentVersionId])
  @@map("user_legal_acceptances")
}

/// Admin-managed marketplace category (name, slug, icons for mobile).
model ServiceCategory {
  id        String   @id @default(uuid()) @db.Uuid
  /// Stable key for APIs and deep links (e.g. "cleaning", "food").
  slug      String   @unique
  /// Optional preset icon id for clients (e.g. FontAwesome5 glyph name: "car", "broom").
  iconKey   String?  @map("icon_key")
  /// Optional custom icon image URL (uploaded asset).
  iconUrl   String?  @map("icon_url")
  sortOrder Int      @default(0) @map("sort_order")
  active    Boolean  @default(true)
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  services     Service[]
  translations ServiceCategoryTranslation[]
  favoritedBy  ClientFavorite[] @relation("ClientFavoriteCategory")

  @@index([active, sortOrder])
  @@map("service_categories")
}

/// Catalog service a provider applies for; belongs to one `ServiceCategory`.
model Service {
  id         String   @id @default(uuid()) @db.Uuid
  categoryId String   @map("category_id") @db.Uuid
  active     Boolean  @default(true)
  servicePhoto String? @map("service_photo")
  createdAt  DateTime @default(now()) @map("created_at")
  updatedAt  DateTime @updatedAt @map("updated_at")

  category                   ServiceCategory             @relation(fields: [categoryId], references: [id], onDelete: Restrict)
  givenServices              GivenService[]
  verificationProfilRequests VerificationProfilRequest[]
  translations               ServiceTranslation[]
  searchHistory              ClientSearchHistory[]
  favoritedBy                ClientFavorite[] @relation("ClientFavoriteService")

  @@index([categoryId])
  @@index([active, categoryId])
  @@map("services")
}

model ClientSearchHistory {
  id        String   @id @default(uuid()) @db.Uuid
  clientId  String   @map("client_id") @db.Uuid
  serviceId String   @map("service_id") @db.Uuid
  query     String?  @db.Text
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  client  Client  @relation(fields: [clientId], references: [id], onDelete: Cascade)
  service Service @relation(fields: [serviceId], references: [id], onDelete: Cascade)

  @@unique([clientId, serviceId])
  @@index([clientId, updatedAt])
  @@index([serviceId])
  @@map("client_search_history")
}

model ClientFavorite {
  id         String       @id @default(uuid()) @db.Uuid
  clientId   String       @map("client_id") @db.Uuid
  type       FavoriteType
  categoryId String?      @map("category_id") @db.Uuid
  serviceId  String?      @map("service_id") @db.Uuid
  providerId String?      @map("provider_id") @db.Uuid
  createdAt  DateTime     @default(now()) @map("created_at")
  updatedAt  DateTime     @updatedAt @map("updated_at")

  client   Client           @relation(fields: [clientId], references: [id], onDelete: Cascade)
  category ServiceCategory? @relation("ClientFavoriteCategory", fields: [categoryId], references: [id], onDelete: Cascade)
  service  Service?         @relation("ClientFavoriteService", fields: [serviceId], references: [id], onDelete: Cascade)
  provider Provider?        @relation("ClientFavoriteProvider", fields: [providerId], references: [id], onDelete: Cascade)

  @@unique([clientId, categoryId])
  @@unique([clientId, serviceId])
  @@unique([clientId, providerId])
  @@index([clientId, type, createdAt])
  @@map("client_favorites")
}

model ServiceCategoryTranslation {
  id         String   @id @default(uuid()) @db.Uuid
  categoryId String   @map("category_id") @db.Uuid
  locale     Locale
  name       String
  createdAt  DateTime @default(now()) @map("created_at")
  updatedAt  DateTime @updatedAt @map("updated_at")

  category ServiceCategory @relation(fields: [categoryId], references: [id], onDelete: Cascade)

  @@unique([categoryId, locale])
  @@index([locale, name])
  @@map("service_category_translations")
}

model ServiceTranslation {
  id          String   @id @default(uuid()) @db.Uuid
  serviceId   String   @map("service_id") @db.Uuid
  locale      Locale
  name        String
  description String?  @db.Text
  createdAt   DateTime @default(now()) @map("created_at")
  updatedAt   DateTime @updatedAt @map("updated_at")

  service Service @relation(fields: [serviceId], references: [id], onDelete: Cascade)

  @@unique([serviceId, locale])
  @@index([locale, name])
  @@map("service_translations")
}

/// A concrete service offer created by provider/company for marketplace publishing.
model GivenService {
  id          String      @id @default(uuid()) @db.Uuid
  serviceId   String      @map("service_id") @db.Uuid
  pricingType PricingType @map("pricing_type")
  price       Float
  minimumHours               Int?      @map("minimum_hours")
  estimatedDurationMinutes   Int?      @map("estimated_duration_minutes")
  description                String?   @db.Text
  whatIsIncluded             String?   @map("what_is_included") @db.Text
  whatIsNotIncluded          String?   @map("what_is_not_included") @db.Text
  toolsProvidedByProvider    Boolean?  @map("tools_provided_by_provider")
  serviceAreaNotes           String?   @map("service_area_notes") @db.Text
  advanceBookingRequiredHours Int?     @map("advance_booking_required_hours")
  serviceRadiusKm            Float?    @map("service_radius_km")
  isAvailableImmediately     Boolean?  @map("is_available_immediately")
  averageRating              Decimal?  @map("average_rating") @db.Decimal(3, 2)
  totalReviews               Int?      @map("total_reviews")
  totalCompletedJobs         Int?      @map("total_completed_jobs")
  clientMustProvide          String?   @map("client_must_provide") @db.Text
  ownerType   OwnerType   @map("owner_type")
  ownerId     String      @map("owner_id") @db.Uuid
  active      Boolean     @default(false)
  createdAt   DateTime    @default(now()) @map("created_at")
  updatedAt   DateTime    @updatedAt @map("updated_at")

  service   Service          @relation(fields: [serviceId], references: [id], onDelete: Cascade)
  galleries ServiceGallery[]
  appointments Appointment[]

  @@index([serviceId])
  @@index([ownerType, ownerId])
  @@index([active])
  @@map("given_services")
}

model ServiceGallery {
  id             String @id @default(uuid()) @db.Uuid
  givenServiceId String @map("given_service_id") @db.Uuid
  imageUrl       String @map("image_url")

  givenService GivenService @relation(fields: [givenServiceId], references: [id], onDelete: Cascade)

  @@index([givenServiceId])
  @@map("service_gallery")
}

/// Weekly recurring availability template per provider.
/// One row per day of week. Provider sets working hours for each active day.
model ProviderAvailability {
  id         String    @id @default(uuid()) @db.Uuid
  providerId String    @map("provider_id") @db.Uuid
  dayOfWeek  DayOfWeek @map("day_of_week")
  isWorking  Boolean   @default(true) @map("is_working")
  startTime  String    @map("start_time") // "HH:MM" 24h format e.g. "08:00"
  endTime    String    @map("end_time") // "HH:MM" 24h format e.g. "18:00"
  createdAt  DateTime  @default(now()) @map("created_at")
  updatedAt  DateTime  @updatedAt @map("updated_at")

  provider Provider @relation(fields: [providerId], references: [id], onDelete: Cascade)

  @@unique([providerId, dayOfWeek])
  @@index([providerId])
  @@map("provider_availability")
}

/// A specific day the provider explicitly blocks out (holiday, unavailable day).
model ProviderDayOff {
  id         String   @id @default(uuid()) @db.Uuid
  providerId String   @map("provider_id") @db.Uuid
  date       DateTime @db.Date // the blocked date (date only, no time)
  reason     String?  @db.Text
  createdAt  DateTime @default(now()) @map("created_at")

  provider Provider @relation(fields: [providerId], references: [id], onDelete: Cascade)

  @@unique([providerId, date])
  @@index([providerId, date])
  @@map("provider_days_off")
}

/// A booking request from a client for a specific GivenService on a specific date/time.
model Appointment {
  id             String            @id @default(uuid()) @db.Uuid
  clientId       String            @map("client_id") @db.Uuid
  givenServiceId String            @map("given_service_id") @db.Uuid
  providerId     String            @map("provider_id") @db.Uuid
  status         AppointmentStatus @default(PENDING)
  scheduledDate  DateTime          @db.Date @map("scheduled_date") // date only
  scheduledTime  String            @map("scheduled_time") // "HH:MM"
  notes          String?           @db.Text
  photoUrls      String[]          @default([]) @map("photo_urls") // client attachments

  // Provider response
  refusalReason  String?   @map("refusal_reason") @db.Text
  rescheduleDate DateTime? @db.Date @map("reschedule_date")
  rescheduleTime String?   @map("reschedule_time")

  // Execution tracking
  enRouteAt       DateTime? @map("en_route_at")
  startedAt       DateTime? @map("started_at")
  completedAt     DateTime? @map("completed_at")
  durationMinutes Int?      @map("duration_minutes") // computed on completion

  // Photos uploaded during/after intervention
  beforePhotoUrls String[] @default([]) @map("before_photo_urls")
  afterPhotoUrls  String[] @default([]) @map("after_photo_urls")

  // Cancellation
  cancelledBy        String?   @map("cancelled_by") // "CLIENT" | "PROVIDER"
  cancellationReason String?   @map("cancellation_reason") @db.Text
  cancelledAt        DateTime? @map("cancelled_at")

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  client        Client                    @relation(fields: [clientId], references: [id], onDelete: Cascade)
  givenService  GivenService              @relation(fields: [givenServiceId], references: [id], onDelete: Restrict)
  provider      Provider                  @relation(fields: [providerId], references: [id], onDelete: Restrict)
  confirmations AppointmentConfirmation[]

  @@index([clientId, status])
  @@index([providerId, scheduledDate])
  @@index([givenServiceId])
  @@index([status])
  @@map("appointments")
}

/// Dual-confirmation log: client and provider each confirm START and END.
model AppointmentConfirmation {
  id            String                      @id @default(uuid()) @db.Uuid
  appointmentId String                      @map("appointment_id") @db.Uuid
  confirmedBy   String                      @map("confirmed_by") @db.Uuid // user id
  role          String // "CLIENT" | "PROVIDER"
  type          AppointmentConfirmationType
  confirmedAt   DateTime                    @default(now()) @map("confirmed_at")

  appointment Appointment @relation(fields: [appointmentId], references: [id], onDelete: Cascade)

  @@unique([appointmentId, role, type])
  @@index([appointmentId])
  @@map("appointment_confirmations")
}

/// Uploaded file metadata; provider verification files belong to one `VerificationProfilRequest`.
model Document {
  id                    String       @id @default(uuid()) @db.Uuid
  ownerUserId           String       @map("owner_user_id") @db.Uuid
  verificationRequestId String       @map("verification_request_id") @db.Uuid
  type                  DocumentType
  fichierUrl            String       @map("fichier_url")
  uploadedAt            DateTime     @default(now()) @map("uploaded_at")
  validatedAt           DateTime?    @map("validated_at")
  /// Admin per-file decision: null = not reviewed yet, true = accepted, false = rejected.
  isAccepted            Boolean?     @map("is_accepted")
  /// When `isAccepted` is false, admin explanation shown to the applicant.
  rejectionReason       String?      @map("rejection_reason") @db.Text

  ownerUser           User                      @relation(fields: [ownerUserId], references: [id], onDelete: Cascade)
  verificationRequest VerificationProfilRequest @relation(fields: [verificationRequestId], references: [id], onDelete: Cascade)

  @@index([ownerUserId])
  @@index([verificationRequestId])
  @@index([type])
  @@map("documents")
}

/// Provider: one catalog service + documents. Company: documents only (`serviceId` null).
model VerificationProfilRequest {
  id            String       @id @default(uuid()) @db.Uuid
  userId        String       @map("user_id") @db.Uuid
  ownerType     OwnerType    @map("owner_type")
  serviceId     String?      @map("service_id") @db.Uuid
  requestStatus ReviewStatus @default(PENDING) @map("request_status")
  adminComment  String?      @map("admin_comment") @db.Text
  ownerComment  String?      @map("owner_comment") @db.Text
  createdAt     DateTime     @default(now()) @map("created_at")
  updatedAt     DateTime     @updatedAt @map("updated_at")

  user      User       @relation(fields: [userId], references: [id], onDelete: Cascade)
  service   Service?   @relation(fields: [serviceId], references: [id], onDelete: SetNull)
  documents Document[]

  @@index([userId])
  @@index([serviceId])
  @@index([requestStatus])
  @@map("verification_profil_requests")
}

/// Stores the Expo push token for each user device.
/// One user can have multiple devices (tokens).
model PushToken {
  id        String   @id @default(uuid()) @db.Uuid
  userId    String   @map("user_id") @db.Uuid
  token     String // Expo push token: "ExponentPushToken[xxx]"
  platform  String // "ios" | "android"
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, token])
  @@index([userId])
  @@map("push_tokens")
}

/// Persisted notification row — drives both the in-app inbox and Supabase Realtime.
model Notification {
  id        String           @id @default(uuid()) @db.Uuid
  userId    String           @map("user_id") @db.Uuid // recipient
  type      NotificationType
  title     String
  body      String           @db.Text
  data      Json? // arbitrary payload (appointmentId, etc.)
  isRead    Boolean          @default(false) @map("is_read")
  readAt    DateTime?        @map("read_at")
  createdAt DateTime         @default(now()) @map("created_at")

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, isRead, createdAt])
  @@index([userId, createdAt])
  @@map("notifications")
}


